{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "SnapForge",
    "version": "1.0.0",
    "identifier": "com.snapforge.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "SnapForge",
                "fullscreen": false,
                "width": 620,
                "height": 74,
                "resizable": false,
                "transparent": true,
                "decorations": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "shadow": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval' blob: https://unpkg.com; worker-src 'self' blob:; media-src 'self' blob: data:; connect-src 'self' blob: data: https://unpkg.com https://cdn.jsdelivr.net;"
        }
    },
    "plugins": {
        "globalShortcut": {},
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxOTA2NERBMTRBNUMyQjMKUldTendxVVUybVNRNFd2RWZ4NmZoVmRrZVJzdDlMWmJxUVJlR2ZzWElxOVdQWHRNVS9VSFM0OHkK",
            "endpoints": [
                "https://github.com/herisusantoarismann/snapforge/releases/latest/download/latest.json"
            ]
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "category": "Graphics and Design",
        "shortDescription": "Precision Screen Capture & Workflow Studio",
        "longDescription": "SnapForge is a high-performance desktop screen capture, annotation, and developer diagnostic utility.",
        "icon": [
            "icons/32x32.png",
            "icons/64x64.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/256x256.png",
            "icons/512x512.png",
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installerIcon": "icons/icon.ico",
                "headerImage": "icons/installer-header.bmp",
                "sidebarImage": "icons/installer-sidebar.bmp",
                "template": "nsis/installer.nsi"
            }
        },
        "macOS": {
            "dmg": {
                "background": "icons/dmg-background.png",
                "windowSize": {
                    "width": 660,
                    "height": 410
                },
                "appPosition": {
                    "x": 116,
                    "y": 180
                },
                "applicationFolderPosition": {
                    "x": 544,
                    "y": 180
                }
            }
        },
        "linux": {
            "deb": {
                "section": "graphics"
            },
            "rpm": {
                "release": "1"
            },
            "appimage": {
                "bundleMediaFramework": false
            }
        }
    }
}
