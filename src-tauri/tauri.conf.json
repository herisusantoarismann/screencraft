{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screencraft",
  "version": "0.1.0",
  "identifier": "com.my-pc.screencraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "screencraft",
        "fullscreen": false,
        "width": 620,
        "height": 74,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval' blob: https://unpkg.com; worker-src 'self' blob:; media-src 'self' blob: data:; connect-src 'self' blob: data: https://unpkg.com https://cdn.jsdelivr.net;"
    }
  },
  "plugins": {
    "globalShortcut": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
