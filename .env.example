# ScreenCraft Environment Configuration
# Copy this file to .env and adjust variables as needed

# Discord Incoming Webhook URL for automated error & crash reporting
# Example: https://discord.com/api/webhooks/1234567890/ABCDEF...
VITE_DISCORD_CRASH_WEBHOOK_URL=

# Discord Incoming Webhook URL for user feedback, ideas & bug reports
# (If left blank, it will automatically fallback to VITE_DISCORD_CRASH_WEBHOOK_URL or Settings webhook)
VITE_DISCORD_FEEDBACK_WEBHOOK_URL=
